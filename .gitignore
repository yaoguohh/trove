# === Swift Package Manager ===
.build/
.swiftpm/
# Package.resolved is committed (this is an app, not a library) — do NOT ignore it.

# === Xcode user state (written even without an .xcodeproj when the package is opened in Xcode) ===
xcuserdata/
*.xcuserstate
DerivedData/

# === macOS ===
.DS_Store

# === VS Code — personal/local state ===
.vscode/

# === Project-specific ===
# Release artifacts (the .dmg and appcast.xml) — generated by CI / the package scripts, served from
# GitHub Releases, never committed.
dist/
